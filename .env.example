# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Must be set — server refuses to start without it
JWT_SECRET=change-me-to-a-long-random-string

# Public URL (no trailing slash)
APP_URL=https://servemasteracademy.ca

# Admin account — auto-granted admin role on startup
ADMIN_EMAIL=you@example.com

# ─── Database ─────────────────────────────────────────────────────────────────
# Replit PostgreSQL — auto-injected in Replit environment
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── OpenAI (AI role-play + TTS) ─────────────────────────────────────────────
# Use one of the two below (Replit integration auto-injects both)
OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_API_KEY=   # auto-injected by Replit OpenAI integration
AI_INTEGRATIONS_OPENAI_BASE_URL=  # auto-injected by Replit OpenAI integration

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ─── Stripe (Live mode) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (CAD)
STRIPE_PREMIUM_MONTHLY_ID=price_...   # $19/mo individual
STRIPE_PREMIUM_ANNUAL_ID=price_...    # $149/yr individual
STRIPE_STARTER_TEAM_ID=price_...      # $99/mo team starter
STRIPE_PRO_TEAM_ID=price_...          # $199/mo team pro
STRIPE_STARTER_TEAM_ANNUAL_ID=price_... # $990/yr team starter
STRIPE_PRO_TEAM_ANNUAL_ID=price_...     # $1,990/yr team pro

# ─── Resend (transactional email) ─────────────────────────────────────────────
# Replit Resend integration auto-injects this
RESEND_API_KEY=re_...
