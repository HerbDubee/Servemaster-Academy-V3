entrypoint = "index.html"
modules = ["web", "nodejs-20", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_11"
packages = ["tambura", "vimPlugins.LanguageClient-neovim"]

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "blog-freshness"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[[workflows.workflow]]
name = "blog-freshness"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-blog-freshness.js"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 80
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0", "stripe:2.0.0", "resend:1.0.0"]

[userenv]

[userenv.shared]
# Non-secret shared defaults only. Put all secrets in Replit Secrets.
SUPPORT_EMAIL = "support@servemasteracademy.ca"
HELLO_EMAIL = "hello@servemasteracademy.ca"
INFO_EMAIL = "info@servemasteracademy.ca"
SMTP_HOST = "mail.privateemail.com"
SMTP_PORT = "465"
STRIPE_PREMIUM_MONTHLY_ID = "price_1T6zlYExNgORioBp06MwjAnO"
STRIPE_PREMIUM_ANNUAL_ID = "price_1T6zmiExNgORioBp78rqoHQF"
STRIPE_STARTER_TEAM_ID = "price_1T6zoHExNgORioBpkHFfppKN"
STRIPE_PRO_TEAM_ID = "price_1T700zExNgORioBp0eD0BZo1"
ADMIN_EMAIL = "kirk_adamson@servemasteracademy.ca"

[userenv.production]
APP_URL = "https://servemasteracademy.ca"

[userenv.development]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
